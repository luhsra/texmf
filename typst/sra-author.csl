<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="de-DE">
  <info>
    <title>SRA quote attribution: Author Year: Title [number]</title>
    <id>https://www.sra.uni-hannover.de/styles/sra-author</id>
    <updated>2026-10-15T00:00:00+00:00</updated>
  </info>
  <!-- Matches the source line of beamertools' btQuote environment. -->
  <macro name="attribution">
    <group delimiter=" ">
      <group delimiter=": ">
        <group delimiter=" ">
          <names variable="author">
            <name form="short" and="text" delimiter=", "/>
          </names>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </group>
        <text variable="title" font-style="italic"/>
      </group>
      <text variable="citation-number" prefix="[" suffix="]"/>
    </group>
  </macro>
  <citation et-al-min="4" et-al-use-first="3">
    <layout delimiter="; ">
      <text macro="attribution"/>
    </layout>
  </citation>
  <bibliography et-al-min="4" et-al-use-first="3">
    <layout>
      <text macro="attribution"/>
    </layout>
  </bibliography>
</style>
